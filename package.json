{
  "name": "@ra-libs/nestjs",
  "version": "1.5.19",
  "description": "React admin nestjs lib",
  "author": "Rabah Zeineddine",
  "license": "MIT",
  "readmeFilename": "README.md",
  "main": "dist/index.js",
  "files": [
    "dist/**/*",
    "*.md"
  ],
  "scripts": {
    "start:dev": "tsc -w",
    "preinstall": "npx only-allow pnpm",
    "prebuild": "rm -rf dist",
    "build": "tsc",
    "prepare": "npm run build && husky",
    "format": "prettier --write \"src/**/*.ts\"",
    "prelint": "npm run format",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest --coverage --maxWorkers=2 --detectOpenHandles --forceExit --passWithNoTests",
    "test:local": "jest --verbose --coverage --maxWorkers=8 --detectOpenHandles --forceExit",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "presemantic-release": "npm run build",
    "semantic-release": "semantic-release"
  },
  "keywords": [
    "nestjs",
    "react-admin",
    "ra"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@types/qs": "^6.14.0",
    "content-range": "^2.0.2",
    "flat": "^5.0.2",
    "lodash": "^4.17.21",
    "luxon": "^3.7.2",
    "qs": "^6.14.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.0.1",
    "rxjs": "^7.8.2",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^9.38.0",
    "@nestjs/testing": "^11.1.6",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.0",
    "@semantic-release/npm": "^13.0.0",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/express": "^5.0.3",
    "@types/flat": "^5.0.5",
    "@types/jest": "30.0.0",
    "@types/node": "^24.8.1",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "eslint": "^9.38.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.2.0",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "jest": "30.2.0",
    "prettier": "^2.8.8",
    "semantic-release": "^25.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.4",
    "ts-jest": "29.4.5",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ra-libs/nestjs"
  }
}